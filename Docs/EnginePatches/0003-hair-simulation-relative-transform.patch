-FMatrix44f ComputeBoneTransform(const FNDIHairStrandsData* InstanceData, const TRefCountPtr<FHairGroupInstance>& GroupInstance)
+// MO57 (Docs/Engine_Patches.md #3): the simulation bone's world transform in DOUBLE. The engine cast it to float before the relative transform
+// below was taken, so far from the world origin (~1 mm per float step at 17 km) the solver's frame jumped by rounding error every frame.
+static FMatrix44d ComputeBoneTransformDouble(const FNDIHairStrandsData* InstanceData, const TRefCountPtr<FHairGroupInstance>& GroupInstance)
 {
 	if(InstanceData)
 	{
 		const FTransform RigidTransform = GroupInstance.IsValid() ? GroupInstance->Debug.RigidCurrentLocalToWorld : InstanceData->WorldTransform;
 		if(RigidTransform.IsValid() && InstanceData->BoneTransform.IsValid())
 		{
-			return  FMatrix44f((InstanceData->BoneTransform * RigidTransform).ToMatrixWithScale());
+			return (InstanceData->BoneTransform * RigidTransform).ToMatrixWithScale();
 		}
 	}
-	return FMatrix44f::Identity;
+	return FMatrix44d::Identity;
+}
+
+FMatrix44f ComputeBoneTransform(const FNDIHairStrandsData* InstanceData, const TRefCountPtr<FHairGroupInstance>& GroupInstance)
+{
+	return FMatrix44f(ComputeBoneTransformDouble(InstanceData, GroupInstance));
 }
 
